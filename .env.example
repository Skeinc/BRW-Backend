# --- API (host: `npm run start:dev`) ---
PORT=3000
NODE_ENV=development
# Docker Compose publishes the api on API_PORT (default 3000) and Postgres on POSTGRES_PORT (default 5434).
API_PORT=3000
POSTGRES_PORT=5434
POSTGRES_USER=brw
POSTGRES_PASSWORD=brw
POSTGRES_DB=brw
# On the host Postgres is reachable on localhost:5434. Inside Compose the api uses host `postgres` automatically.
DATABASE_URL=postgresql://brw:brw@localhost:5434/brw
# Storefront origin(s); comma-separated list allowed. Local Vite/SSR dev: http://localhost:5173, Compose web: http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# --- S3 (local MinIO from docker-compose) ---
# Host: MinIO API on localhost:9000. Inside Compose the api uses http://minio:9000 automatically.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=brw-media
# Also used as the MinIO root credentials in docker-compose.
S3_ACCESS_KEY=brwminio
S3_SECRET_KEY=brwminio-secret
# Browser-facing bucket URL (path style: includes the bucket name).
S3_PUBLIC_URL=http://localhost:9000/brw-media
S3_FORCE_PATH_STYLE=true

# --- Admin (stage 6) ---
ADMIN_EMAIL=admin@brw.local
# Placeholder bcrypt hash: nobody can log in with it. Stage 6 adds `npm run admin:hash` to generate a real one.
# Keep single quotes: the hash contains `$` characters.
ADMIN_PASSWORD_HASH='$2b$10$ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0'
JWT_SECRET=dev-jwt-secret-change-me
COOKIE_SECURE=false

# --- Web (docker compose --profile web) ---
WEB_PORT=8080
PUBLIC_API_URL=http://localhost:3000
