# --- API (host: `npm run start:dev`) ---
PORT=3000
NODE_ENV=development
# Docker Compose publishes the api on API_PORT (default 3000) and Postgres on POSTGRES_PORT (default 5434).
API_PORT=3000
POSTGRES_PORT=5434
POSTGRES_USER=brw
POSTGRES_PASSWORD=brw
POSTGRES_DB=brw
# On the host Postgres is reachable on localhost:5434. Inside Compose the api uses host `postgres` automatically.
DATABASE_URL=postgresql://brw:brw@localhost:5434/brw
# Storefront origin(s); comma-separated list allowed. Local Vite/SSR dev: http://localhost:5173, Compose web: http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# --- Media (uploaded photos stored on local disk, served by the api at /media) ---
# Inside Compose the api uses /app/uploads (the uploads_data volume) automatically.
UPLOADS_DIR=./uploads
# Browser-facing base URL of /media.
PUBLIC_MEDIA_URL=http://localhost:3000/media

# --- Admin panel login ---
ADMIN_EMAIL=admin@brw.local
# Password for the admin panel, plain text, at least 6 characters. Docker Compose refuses to start without it.
ADMIN_PASSWORD=change-me-please
# Optional: a bcrypt hash instead of a plain password (`npm run admin:hash -- <password>`). Used only when
# ADMIN_PASSWORD is empty. Keep single quotes: the hash contains `$` characters.
# ADMIN_PASSWORD_HASH=
# Signs the admin cookie. Generate your own: openssl rand -hex 32. Placeholders are rejected in production.
JWT_SECRET=change-me-generate-a-long-random-string
# Number of reverse proxies in front of the API (nginx = 1); leave empty when the API is exposed directly.
TRUST_PROXY=
COOKIE_SECURE=false
# Swagger at /api/docs. On by default outside production, off in production; set true to force it on.
# SWAGGER_ENABLED=false

# --- Web (started by `docker compose up`) ---
WEB_PORT=8080
PUBLIC_API_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:8080
