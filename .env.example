# --- API (host: `npm run start:dev`) ---
PORT=3000
NODE_ENV=development
# Docker Compose publishes the api on API_PORT (default 3000) and Postgres on POSTGRES_PORT (default 5434).
API_PORT=3000
POSTGRES_PORT=5434
POSTGRES_USER=brw
POSTGRES_PASSWORD=brw
POSTGRES_DB=brw
# On the host Postgres is reachable on localhost:5434. Inside Compose the api uses host `postgres` automatically.
DATABASE_URL=postgresql://brw:brw@localhost:5434/brw
# Storefront origin(s); comma-separated list allowed. Local Vite/SSR dev: http://localhost:5173, Compose web: http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# --- Media (uploaded photos stored on local disk, served by the api at /media) ---
# Inside Compose the api uses /app/uploads (the uploads_data volume) automatically.
UPLOADS_DIR=./uploads
# Browser-facing base URL of /media.
PUBLIC_MEDIA_URL=http://localhost:3000/media

# --- Admin panel login ---
ADMIN_EMAIL=admin@brw.local
# Password for the admin panel, plain text, at least 6 characters. Docker Compose refuses to start without it.
ADMIN_PASSWORD=change-me-please
# Optional: a bcrypt hash instead of a plain password (`npm run admin:hash -- <password>`). Used only when
# ADMIN_PASSWORD is empty. Keep single quotes: the hash contains `$` characters.
# ADMIN_PASSWORD_HASH=
# Signs the admin cookie. Generate your own: openssl rand -hex 32. Placeholders are rejected in production.
JWT_SECRET=change-me-generate-a-long-random-string
# Number of reverse proxies in front of the API (nginx = 1); leave empty when the API is exposed directly.
TRUST_PROXY=
COOKIE_SECURE=false
# Swagger at /api/docs. On by default outside production, off in production; set true to force it on.
# SWAGGER_ENABLED=false

# --- Email notifications about new orders ---
# Manager address that receives every new order request. Empty = no emails. Requires SMTP_HOST.
ORDER_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465), false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender, for example: BRW <no-reply@brw.by>. Defaults to SMTP_USER.
MAIL_FROM=

# --- Web (started by `docker compose up`) ---
WEB_PORT=8080
PUBLIC_API_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:8080

# ============================================================================
# PRODUCTION (docker-compose.prod.yml). On the server copy this file to
# .env.production and change the values below. The dev values above
# (PORT, DATABASE_URL, CORS_ORIGIN, UPLOADS_DIR, PUBLIC_MEDIA_URL, WEB_PORT,
# PUBLIC_API_URL, PUBLIC_SITE_URL, API_PORT, POSTGRES_PORT) are ignored there:
# the prod compose derives them from DOMAIN. Never commit .env.production.
# ============================================================================
# Canonical host without scheme and without www (www gets a 301 to it).
DOMAIN=example.by
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=admin@example.by
# Strong secrets: POSTGRES_PASSWORD (openssl rand -hex 24), JWT_SECRET (openssl rand -hex 32), ADMIN_PASSWORD.
# Image tags for pinning / rollback (default latest). Pin a git sha to roll back.
# API_TAG=latest
# WEB_TAG=latest
# Analytics ids (empty = off): Metrika is digits, GA4 looks like G-XXXXXXXXXX.
PUBLIC_METRIKA_ID=
PUBLIC_GA4_ID=
# Backups run daily at BACKUP_HOUR (UTC) and are kept for BACKUP_RETENTION_DAYS.
BACKUP_HOUR=03
BACKUP_RETENTION_DAYS=14
